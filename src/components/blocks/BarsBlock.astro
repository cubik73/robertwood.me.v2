---
import type { Block } from '../../content.config';

type Props = Extract<Block, { type: 'bars' }>;
const { caption, headline, bars } = Astro.props;
---

<section class="container bars-wrap" aria-label={caption}>
  <div class="bars section--deep">
    <div class="bars__head">
      <p class="eyebrow">{caption}</p>
      <p class="bars__headline">{headline}</p>
    </div>
    <ul class="stack" role="list" style="--gap: 1.25rem">
      {
        bars.map((bar) => (
          <li class="bar">
            <span class="bar__labels">
              <span>{bar.label}</span>
              <span class="mono">
                {bar.percent}% · {bar.note}
              </span>
            </span>
            <span class="bar__track" aria-hidden="true">
              <span class="bar__fill" style={`width: ${bar.percent}%`} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bars-wrap {
    padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .bars {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
  }

  .bars__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }

  .bars__headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 4.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--hi);
  }

  .bar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bar__labels {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--on-deep-muted);
    font-size: 0.9375rem;
  }

  .bar__track {
    display: block;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: var(--deep-2);
    overflow: hidden;
  }

  .bar__fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-sm);
    background: var(--hi);
  }
</style>
