---
import type { Block } from '../../content.config';
import Placeholder from '../Placeholder.astro';

type Props = Extract<Block, { type: 'images' }>;
const { items } = Astro.props;
---

<div class="container grid images-block" style="--min: 20rem; --gap: 1.75rem">
  {
    items.map((item) => (
      <figure>
        <Placeholder image={item} class="images-block__img" />
        {item.caption && <figcaption class="muted">{item.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .images-block {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  :global(.images-block__img) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }
</style>
