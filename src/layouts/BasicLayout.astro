---
/** Basic page template: title, intro and rich text (privacy, colophon, etc.). */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  intro: string;
  description?: string;
}

const { title, intro, description } = Astro.props;
---

<BaseLayout title={title} description={description ?? intro}>
  <article class="container basic">
    <h1 class="title-lg">{title}</h1>
    <p class="lede">{intro}</p>
    <div class="prose basic__body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .basic {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 48rem;
    padding-block: clamp(3rem, 8vw, 5.5rem);
  }

  .basic__body :global(h2) {
    margin-top: 2rem;
    font-size: 1.6rem;
  }
</style>
