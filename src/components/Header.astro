---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

// "/work/" is the current page; on "/work/myfstvl/" the Work item marks the current section.
const path = Astro.url.pathname;
const section = `/${path.split('/')[1]}/`;
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />
    <nav aria-label="Main">
      <ul class="site-nav" role="list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === path ? 'page' : item.href === section ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      {site.cv && <a class="btn btn--ink" href={site.cv}>Download CV</a>}
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Floating pill that stays in view, like the current robertwood.me. */
  .site-header {
    position: sticky;
    top: 0.75rem;
    z-index: 50;
    margin-top: 0.75rem;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.4rem 0.5rem 0.4rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(18px) saturate(1.8);
    box-shadow: 0 8px 24px var(--shadow);
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header__inner {
      background: var(--paper);
      backdrop-filter: none;
    }
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .site-nav a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    color: var(--ink-2);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .site-nav a[aria-current] {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    font-weight: 600;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-header__actions :global(.btn) {
    border-radius: 999px;
  }

  @media (max-width: 40rem) {
    /* Links wrap onto extra rows here: too tall to stay pinned, and too tall for a pill.
       shortcut: no menu button on phones, add one if the bar should float on mobile too. */
    .site-header {
      position: static;
    }

    .site-header__inner {
      border-radius: var(--radius-lg);
      padding: 0.5rem 0.5rem 0.5rem 1rem;
    }

    nav {
      order: 3;
      width: 100%;
    }

    .site-nav a {
      padding-inline: 0.7rem;
    }
  }
</style>
