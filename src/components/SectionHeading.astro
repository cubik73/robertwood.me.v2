---
/**
 * Eyebrow label + heading. Pass `number` to prefix "01 / " (generated from
 * block order, so editors only type the label).
 */
interface Props {
  label: string;
  heading: string;
  number?: number;
  level?: 2 | 3;
  size?: 'md' | 'sm';
  id?: string;
}

const { label, heading, number, level = 2, size = 'md', id } = Astro.props;
const prefix = number ? `${String(number).padStart(2, '0')} / ` : '';
const Tag = level === 2 ? 'h2' : 'h3';
---

<div class="section-heading">
  <p class="eyebrow">{prefix}{label}</p>
  <Tag id={id} class={`title-${size}`}>{heading}</Tag>
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
</style>
