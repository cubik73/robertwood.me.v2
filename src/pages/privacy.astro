import BasicLayout from '../layouts/BasicLayout.astro';
---

<BasicLayout title="Privacy" intro="This site doesn't track you.">
  <p>
    There are no analytics, advertising or tracking cookies. Fonts are served from this site, not a third party, so
    visiting doesn't share your details with anyone else.
  </p>
  <p>
    If you choose a light or dark theme, that choice is saved in your browser's local storage so it's remembered on your
    next visit. It never leaves your device.
  </p>
  <p>
    If you <a href="/request-cv/">request my CV</a>, the details you enter are emailed to me and used only to send
    it. They aren't stored on this site.
  </p>
  <p>
    If you email me, I'll use your message only to reply. Questions? <a href="mailto:hello@robertwood.me"
      >hello@robertwood.me</a
    >
  </p>
</BasicLayout>
